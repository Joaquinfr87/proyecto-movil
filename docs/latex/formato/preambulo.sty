% ============================================================================
%  PREÁMBULO / FORMATO DEL INFORME  (normas APA · tipografía Arial)
%  ----------------------------------------------------------------------------
%  Este archivo concentra TODOS los paquetes y configuraciones de apariencia.
%  El contenido del informe NO se escribe aquí.
%
%  NOTA SOBRE LA TIPOGRAFÍA:
%  Se usa Helvetica (paquete `helvet`), el sustituto estándar de Arial en LaTeX,
%  porque el paquete `uarial` (fuente Arial URW) fue retirado de TeX Live 2026
%  y de CTAN. Helvetica y Arial son tipografías grotescas prácticamente
%  idénticas, por lo que el resultado visual es equivalente.
%
%  NOTA SOBRE LAS REFERENCIAS:
%  La lista de referencias se genera con el paquete apacite, que sigue la
%  norma APA (sexta edición) para las citas y la bibliografía.
% ============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{formato/preambulo}[2026/08/11 Formato APA profesional con Arial]

% --- Idioma y codificación --------------------------------------------------
\RequirePackage[spanish,es-tabla]{babel}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}

% --- Tipografía Arial (Helvetica a escala visual de 12 pt) ------------------
\RequirePackage[scaled=0.96]{helvet}
\renewcommand{\familydefault}{\sfdefault}

% --- Márgenes de 1 pulgada en papel carta (APA 7) ---------------------------
\RequirePackage[letterpaper,top=1in,bottom=1in,left=1in,right=1in]{geometry}

% --- Interlineado doble (APA 7) ---------------------------------------------
\RequirePackage[doublespacing]{setspace}

% --- Pie de página: número de página centrado al pie ------------------------
\RequirePackage{fancyhdr}
\setlength{\headheight}{14.5pt}   % altura suficiente para la fuente sans
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% --- Jerarquía de títulos estilo APA ----------------------------------------
%  Nivel 1 (sección): alineado a la izquierda y en negrita  |  Nivel 2
%  (subsección): alineado a la izquierda y en negrita      |  Nivel 3:
%  izquierda, negrita y cursiva.
\RequirePackage{titlesec}
\titleformat{\section}{\bfseries\Large}{\thesection}{0.6em}{}
\titlespacing*{\section}{0pt}{12pt}{6pt}
\titleformat{\subsection}{\bfseries\large}{\thesubsection}{0.6em}{}
\titlespacing*{\subsection}{0pt}{12pt}{6pt}
\titleformat{\subsubsection}{\bfseries\normalsize\itshape}{\thesubsubsection}{0.6em}{}
\titlespacing*{\subsubsection}{0pt}{6pt}{6pt}

% --- Párrafos: sin sangría, justificados y con un pequeño espaciado entre
% párrafos para mantenerlos diferenciados (APA 7 usa sangría, pero el
% formato del informe exige alineación justificada sin sangría) --------------
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}
\setlength{\emergencystretch}{3em}

% --- Tablas y figuras --------------------------------------------------------
\RequirePackage{booktabs}        % tablas profesionales
\RequirePackage{float}           % posicionamiento de flotantes
\setlength{\tabcolsep}{4pt}      % evita desbordes por el ancho de las columnas
\RequirePackage{caption}
\captionsetup{font=small, labelfont=bf, textfont=it, singlelinecheck=false, skip=6pt}
\captionsetup[table]{labelsep=newline, position=above}
\captionsetup[figure]{labelsep=period, position=below}

% Entorno para tablas APA: espaciado sencillo y cuerpo en tamaño pequeño.
% El desborde de líneas se evita con \tabcolsep y el ancho de las columnas.
\newenvironment{tablaAPA}{\setstretch{1}\small}{}

% --- Gráficos y diagramas ----------------------------------------------------
\RequirePackage{graphicx}
\graphicspath{{figuras/}}   % las imágenes se colocan en la carpeta figuras/
\RequirePackage{tikz}
\usetikzlibrary{shapes.geometric, arrows.meta, positioning, calc}

% --- Código fuente -----------------------------------------------------------
\RequirePackage{listings}
\RequirePackage{xcolor}
\definecolor{codigofondo}{RGB}{245,245,245}
\lstset{
  basicstyle=\ttfamily\footnotesize,
  backgroundcolor=\color{codigofondo},
  frame=single,
  breaklines=true
}

% --- Listas, matemáticas y microtipografía -----------------------------------
\RequirePackage{enumitem}
\setlist{itemsep=2pt, parsep=0pt, topsep=6pt, partopsep=0pt}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{microtype}

% --- Índices ----------------------------------------------------------------
\RequirePackage{tocloft}
\setcounter{tocdepth}{3}
\setcounter{secnumdepth}{3}
% Las secciones se numeran por capítulo (1.10, 2.7, ...), por lo que la
% columna de números del índice debe ser más ancha para evitar desbordes.
\setlength{\cftsecnumwidth}{2.8em}
\setlength{\cftsubsecnumwidth}{3.8em}
\setlength{\cftsubsubsecnumwidth}{4.6em}

% --- Hipervínculos -----------------------------------------------------------
\RequirePackage[colorlinks=true, linkcolor=black, urlcolor=blue, citecolor=black]{hyperref}

% --- Referencias en formato APA (paquete apacite) ----------------------------
\RequirePackage[natbibapa]{apacite}

% --- Carátula de capítulo (1 hoja completa) -----------------------------------
% Uso: \caratulaCapitulo{CAP\'ITULO I}{INTRODUCCI\'ON}
% Cada capítulo comienza con una página de presentación que ocupa una hoja
% completa. La carátula no muestra número de página ni se cuenta dentro de la
% enumeración (el contador se decrementa tras su salida).
% Las secciones se numeran por capítulo (1.1, 1.2 ... y 2.1, 2.2 ...).
\newcounter{capitulo}
\renewcommand{\thesection}{\arabic{capitulo}.\arabic{section}}
\newcommand{\caratulaCapitulo}[2]{%
  \clearpage
  \refstepcounter{capitulo}%
  \setcounter{section}{0}%
  \thispagestyle{empty}%
  \begin{center}
    \vspace*{6.2cm}
    {\bfseries\Huge #1 \par}
    \vspace{1.7cm}
    {\bfseries\LARGE #2 \par}
  \end{center}
  \clearpage
  \addtocounter{page}{-1}%
}

\endinput
