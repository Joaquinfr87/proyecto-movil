% ============================================================================
%  PREÁMBULO / FORMATO  (estilo APA, 7.ª edición)
%  ----------------------------------------------------------------------------
%  Este archivo concentra TODOS los paquetes y configuraciones de formato.
%  El contenido NO debe ir aquí.
%
%  Nota: si se instala texlive-publishers (sudo apt install texlive-publishers),
%  se puede cambiar \documentclass en main.tex a:  \documentclass[stu]{apa7}
%  y eliminar la carga de newtxtext/newtxmath (apa7 ya usa Times New Roman).
% ============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{formato/preambulo}[2026/08/11 Configuración de formato APA]

% --- Idioma ----------------------------------------------------------------
\RequirePackage[spanish,es-tabla]{babel}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}

% --- Tipografía estilo Times New Roman (APA) --------------------------------
\RequirePackage{mathptmx}

% --- Márgenes 1 pulgada y página tamaño carta (APA) -------------------------
\RequirePackage[letterpaper,top=1in,bottom=1in,left=1in,right=1in]{geometry}

% --- Interlineado doble (APA) ----------------------------------------------
\RequirePackage[doublespacing]{setspace}

% --- Cabecera con número de página (APA: arriba a la derecha) ---------------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\thepage}
\renewcommand{\headrulewidth}{0pt}

% --- Tablas y figuras -------------------------------------------------------
\RequirePackage{booktabs}        % tablas profesionales
\RequirePackage{float}           % posicionamiento de flotantes
\RequirePackage{caption}
\captionsetup{labelfont=bf, textfont=normal, skip=10pt}

% --- Gráficos y diagramas ---------------------------------------------------
\RequirePackage{graphicx}
\graphicspath{{figuras/}}   % las imágenes se colocan en la carpeta figuras/
\RequirePackage{tikz}
\usetikzlibrary{shapes.geometric, arrows.meta, positioning}

% --- Código fuente ----------------------------------------------------------
\RequirePackage{listings}
\RequirePackage{xcolor}
\definecolor{codigofondo}{RGB}{245,245,245}
\lstset{
  basicstyle=\ttfamily\footnotesize,
  backgroundcolor=\color{codigofondo},
  frame=single,
  breaklines=true
}

% --- Listas y otros ---------------------------------------------------------
\RequirePackage{enumitem}
\setlist{itemsep=0pt, parsep=0pt}
\RequirePackage{amsmath}

% --- Hipervínculos ----------------------------------------------------------
\RequirePackage[colorlinks=true, linkcolor=black, urlcolor=blue, citecolor=blue]{hyperref}

% --- Referencias en formato APA (paquete apacite) ---------------------------
\RequirePackage[natbibapa]{apacite}

\endinput
